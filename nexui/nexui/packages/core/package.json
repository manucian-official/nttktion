{
  "name": "@nexui/core",
  "version": "2.4.0",
  "description": "NexUI core component library for React",
  "keywords": ["ui", "react", "components", "design-system", "cross-platform"],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@nexui/themes": "workspace:*",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "tsup": "^8.0.2",
    "vitest": "^1.2.2"
  }
}
